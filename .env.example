# ── Angel One SmartAPI (India market data — real-time price stream) ──────────
ANGEL_API_KEY=your_smartapi_key
ANGEL_CLIENT_CODE=your_angel_one_client_id
ANGEL_PASSWORD=your_angel_one_pin
ANGEL_TOTP_SECRET=your_totp_secret_key

# Note: news (Google News RSS) and fundamentals (Screener.in) are scraped
# directly and need no API key.

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/tradingbot

# ── Bot config ────────────────────────────────────────────────────────────────
WATCHLIST=RELIANCE,TCS,INFY
LOG_LEVEL=INFO
